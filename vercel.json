{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/payments/razorpay/:action",
      "destination": "/api/payments/razorpay?action=:action"
    },
    {
      "source": "/api/admin/customers/analytics",
      "destination": "/api/admin/customers?view=analytics"
    },
    {
      "source": "/api/uploads/:type(jewellery-inspiration|product-image)",
      "destination": "/api/uploads?type=:type"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

