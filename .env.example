# Alongkar - Environment Variables Template
# Copy this file to .env or .env.local and fill in your values.

# Clerk Authentication (Required for frontend authentication)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# Backend / Database Configuration (if using serverless functions or API routes)
# CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here
# DATABASE_URL="postgresql://user:password@host/database?sslmode=require"
# DIRECT_URL="postgresql://user:password@host/database?sslmode=require"

# Cloudinary Media Storage — Account A (Storefront product catalogue media — server-only, never expose to browser/VITE_)
# CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
# CLOUDINARY_API_KEY=your_cloudinary_api_key
# CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Cloudinary Media Storage — Account B (Request Jewellery customer inspiration media — server-only, never expose to browser/VITE_)
# CLOUDINARY_REQUESTS_CLOUD_NAME=your_cloudinary_requests_cloud_name
# CLOUDINARY_REQUESTS_API_KEY=your_cloudinary_requests_api_key
# CLOUDINARY_REQUESTS_API_SECRET=your_cloudinary_requests_api_secret
#RAZORPAY_KEY_ID=your_test_key_id
#RAZORPAY_KEY_SECRET=your_test_secret
# Brevo Transactional Email Configuration (Server-side only - never expose to browser/VITE_)
#BREVO_API_KEY=your_brevo_api_key_here
#BREVO_SENDER_EMAIL=your_verified_sender@example.com
#BREVO_SENDER_NAME=Alongkar
#BREVO_ENABLE_WELCOME_EMAIL=false
#UNSUBSCRIBE_SECRET=put 32 letter random value